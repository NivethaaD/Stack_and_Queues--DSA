class myQueue:
    def __init__(self, n):
        # Define Data Structures
        self.l1 = []
        self.n = n

    def isEmpty(self):
        # Check if queue is empty
        if len(self.l1)==0:
            return True
        return False
    
    def isFull(self):
        # Check if queue is full
        if len(self.l1) == self.n:
            return True
        return False
    
    def enqueue(self, x):
        # Enqueue
        self.l1.append(x)
 
    def dequeue(self):
        # Dequeue
        self.l1.pop(0)

    def getFront(self):
        # Get front element
        if len(self.l1) > 0:
            return self.l1[0]
        return -1
       
    def getRear(self):
        # Get rear element
        if len(self.l1) > 0:
            return self.l1[-1]
        return -1

