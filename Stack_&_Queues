class myStack:

    def __init__(self):
        # Initialize your data members
        self.l1 = []
        self.l2 = []

    def isEmpty(self):
        # Check if the stack is empty
        if(len(self.l1)>0):
            return False
        return True
        
    def push(self, x):
        # Adds element x to the top of the stack
        self.l2.append(x)
        while len(self.l1) > 0:
            self.l2.append(self.l1.pop(0))
        
        self.l1 = self.l2.copy()
        self.l2 = []

    def pop(self):
        # Removes an element from the top of the stack
        self.l1.pop(0)

    def peek(self):
        # Returns the top element of the stack
        # If the stack is empty, return -1
        if len(self.l1)>0:
            return self.l1[0]
        return -1

    def size(self):
        # Returns the current size of the stack
        return len(self.l1)

