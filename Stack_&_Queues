1. Implement Stack using Queues

class MyStack:

    def __init__(self):
        self.l1 = []
        self.l2 = []

    def push(self, x: int) -> None:
        self.l2.append(x)

        while self.l1:
            self.l2.append(self.l1.pop(0))
        
        self.l1, self.l2 = self.l2, self.l1

    def pop(self) -> int:
        last = self.l1.pop(0)
        return last

    def top(self) -> int:
        return self.l1[0]

    def empty(self) -> bool:
        if len(self.l1)==0:
            return True
        return False


