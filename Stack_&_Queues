2. Implement Queue using Stacks

class MyQueue:

    def __init__(self):
        self.l1=[]
        self.l2=[]

    def push(self, x: int) -> None:
        self.l1.append(x)

    def pop(self) -> int:
        self.peek()
        return self.l2.pop()

    def peek(self) -> int:
        if not self.l2:
            while self.l1: # [1,2,3]
                self.l2.append(self.l1.pop()) #[3,2,1]
        return self.l2[-1]

    def empty(self) -> bool:
        return not self.l1 and not self.l2


